{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "predeploy": [
      "rm -rf public/raw_clips && cp -R raw_clips public/raw_clips"
    ],
    "postdeploy": [
      "rm -rf public/raw_clips"
    ],
    "headers": [
      {
        "source": "**/*.glsl",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      },
      {
        "source": "**/*.mp4",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
